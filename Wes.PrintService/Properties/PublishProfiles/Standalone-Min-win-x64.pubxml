<?xml version="1.0" encoding="utf-8"?>
<!--
  最小体积发布配置：自包含（含 .NET 10 运行时）+ 单文件 + 单文件压缩 + 剔除 PDB + 卫星资源只留英文。
  用法（仓库根目录执行）：
    dotnet publish Wes.PrintService -p:PublishProfile=Standalone-Min-win-x64
  输出目录：Wes.PrintService\bin\Release\net10.0-windows\win-x64\publish-standalone\
  产物可直接运行 Deploy\package.bat 打包 zip。

  实测体积（win-x64 / Release）：
    默认自包含（多文件、含 PDB）        215 MB
    本配置                              63 MB（单个 exe 26MB→63MB 是压缩后的自解压包）
    本配置 + 裁剪（PublishTrimmed）     26~30 MB，但 EF Core / MVC 会崩，禁止开启
    框架依赖（-p:SelfContained=false）  30 MB，但目标机必须装 .NET 10 运行时
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish-standalone\</PublishDir>

    <!-- 1) 单文件：把运行时 + 所有 DLL + 原生库（SkiaSharp / librdkafka / SQLite）合成一个 exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 原生库也打进 exe，运行时自动释放到临时目录，部署目录只剩一个 exe + wwwroot -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 2) 单文件压缩：实测 135MB → 63MB（仅自包含支持，不能和 PublishReadyToRun 同开） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 3) 裁剪：本项目严禁开启！
         EF Core / MVC 大量依赖反射，实测 PublishTrimmed=true 时
         db.Database.EnsureCreated() 直接抛
         MissingMethodException: EntryCurrentValueComparer`1[[System.String]] 构造函数丢失，
         TrimMode=partial 时接口全部 500。若将来 EF Core 支持裁剪再评估。 -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!-- 4) 全球化：.NET 10 在 Windows 上直接用系统 ICU，自包含包里并没有 icudt.dat，
         实测开与不开体积几乎一样（62.94MB vs 62.94MB），因此保持 false 以免排序/格式化行为变化。 -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 5) 卫星资源程序集只保留英文，去掉 zh/de/fr/ja... 等本地化资源 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 6) 不生成 PDB / XML 文档 -->
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 7) 运行时功能开关（仅在开启裁剪时才会减少体积，此处保留以便将来启用裁剪） -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <!-- 保留可读的异常信息；改 true 可再省 ~1MB，但异常只剩资源 key，不利于排障 -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- 8) 删除发布目录里的所有 PDB。
       DebugType=none 只管自己项目，管不到引用包：
       SkiaSharp 原生包自带 libSkiaSharp.pdb，单个文件就有 80MB（占默认发布包的 37%！）。 -->
  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
